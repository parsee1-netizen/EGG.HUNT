# Copy to .env.local. The app runs with the local JSON database when Supabase
# is not configured, so you can leave the keys blank for a first look.

# Public URL of this app. Stripe success/cancel URLs are built from it.
# On Vercel, set this to the deployment origin (https://your-app.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data driver.
#   local     — file database in .data/db.json (default when Supabase is unset)
#   supabase  — Postgres via Supabase
# Leave empty to auto-select: supabase when both URL and service role are set,
# otherwise local.
EGG_DATA_DRIVER=

# Supabase project. Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test-mode keys. Dashboard → Developers → API keys.
# Use sk_test_ / pk_test_. Live keys are never required.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from `stripe listen` or the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Demo accounts created by `npm run seed` when a service role key is present.
DEMO_PLAYER_EMAIL=player@eggdrop.demo
DEMO_PLAYER_PASSWORD=eggdrop-demo
DEMO_BUSINESS_EMAIL=cafe@eggdrop.demo
DEMO_BUSINESS_PASSWORD=eggdrop-demo
